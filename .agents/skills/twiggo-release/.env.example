# Release 环境配置文件示例
# 复制为 .env 并填入真实凭证

# ================================
# 1. Cloudflare R2 配置（用于全球加速分发）
# ================================
# Cloudflare 账户 ID（在 Cloudflare 控制台右侧可查）
R2_ACCOUNT_ID=
# R2 API 令牌的 Access Key ID 与 Secret Access Key
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 存储桶名称（例如 twiggo-releases 或绑定的下载桶）
R2_BUCKET_NAME=twiggo-packs
# 绑定在 R2 上的公开加速域名（无需末尾斜杠）
R2_PUBLIC_DOMAIN=https://download.tcommons.top

# ================================
# 2. GitHub Release 配置（用于开源镜像与发布归档）
# ================================
# GitHub Personal Access Token (需勾选 repo 权限)
GITHUB_TOKEN=
# 发布的仓库路径（格式：owner/repo）
GITHUB_REPO=He-Ruisi/neinote_website

# ================================
# 3. 产物路径配置
# ================================
# Neinote_ReX 构建产物目录
RELEASE_DIR=D:\Project\Neinote_ReX\release

